{"legislative_session": "2026", "identifier": "SB 1627", "title": "Modifies provisions relating to stop-payment orders under the UCC", "from_organization": "~{\"classification\": \"upper\"}", "classification": ["bill"], "subject": [], "abstracts": [{"note": "abstract", "abstract": "SB 1627 - Current law provides that a stop-payment order for a draw on any account is only effective for six months. This act repeals the six-month limitation and provides that a stop-payment order is effective unless cancelled by a person authorized to draw on the account.\r\nSCOTT SVAGERA"}], "other_titles": [{"note": "", "title": "Modifies provisions relating to stop-payment orders under the UCC"}], "other_identifiers": [{"identifier": "ocd-bill-mo-2026-sb1627"}], "actions": [{"description": "Second Read and Referred S Insurance and Banking Committee", "date": "2026-02-12T06:00:00+00:00", "organization_id": "~{\"classification\": \"upper\"}", "classification": ["reading-2", "referral-committee"], "related_entities": []}, {"description": "S First Read", "date": "2026-02-05T06:00:00+00:00", "organization_id": "~{\"classification\": \"upper\"}", "classification": ["reading-1"], "related_entities": []}], "sponsorships": [{"name": "Curtis Trent", "classification": "primary", "entity_type": "person", "primary": true, "person_id": "~{\"chamber\": \"upper\", \"name\": \"Curtis Trent\"}", "organization_id": null}], "related_bills": [], "versions": [{"note": "6949S.01I - Introduced", "links": [{"url": "https://www.senate.mo.gov/26info/pdf-bill/intro/SB1627.pdf", "media_type": "application/pdf"}], "date": "", "classification": ""}], "documents": [], "citations": [], "sources": [{"url": "https://www.senate.mo.gov/BillTracking/Bills/BillInformation?year=2026&billid=3537627", "note": ""}], "extras": {"MO_BILL_LR": "6949S.01I"}, "jurisdiction": {"id": "ocd-jurisdiction/country:us/state:mo/government", "name": "Missouri", "classification": "state", "division_id": "ocd-division/country:us/state:mo"}, "
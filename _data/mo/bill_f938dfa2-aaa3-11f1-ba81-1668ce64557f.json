{"legislative_session": "2026", "identifier": "SB 1041", "title": "Authorizes a property tax for special educational services", "from_organization": "~{\"classification\": \"upper\"}", "classification": ["bill"], "subject": [], "abstracts": [{"note": "abstract", "abstract": "SB 1041 - This act authorizes the board of education of a metropolitan school district to impose a tax on real property located in the district for the purpose of funding special educational services in the district. The tax shall not exceed three cents per one hundred dollars assessed valuation.\r\n\r\n\tThis act is identical to SB 203 (2025), SB 966 (2024), and HB 2442 (2024).\r\nJOSH NORBERG"}], "other_titles": [{"note": "", "title": "Authorizes a property tax for special educational services"}], "other_identifiers": [{"identifier": "ocd-bill-mo-2026-sb1041"}], "actions": [{"description": "Second Read and Referred S Education Committee", "date": "2026-01-15T06:00:00+00:00", "organization_id": "~{\"classification\": \"upper\"}", "classification": ["reading-2", "referral-committee"], "related_entities": []}, {"description": "S First Read", "date": "2026-01-07T06:00:00+00:00", "organization_id": "~{\"classification\": \"upper\"}", "classification": ["reading-1"], "related_entities": []}, {"description": "Prefiled", "date": "2025-12-01T06:00:00+00:00", "organization_id": "~{\"classification\": \"upper\"}", "classification": [], "related_entities": []}], "sponsorships": [{"name": "Steven Roberts", "classification": "primary", "entity_type": "person", "primary": true, "person_id": "~{\"chamber\": \"upper\", \"name\": \"Steven Roberts\"}", "organization_id": null}], "related_bills": [], "versions": [{"note": "4780S.01I - Introduced", "links": [{"url": "https://www.senate.mo.gov/26info/pdf-bill/intro/SB1041.pdf", "media_type": "application/pdf"}], "date": "", "classification": ""}], "documents": [], "citations": [], "sources": [{"url": "https://www.senate.mo.gov/BillTracking/Bills/BillInformation?yea
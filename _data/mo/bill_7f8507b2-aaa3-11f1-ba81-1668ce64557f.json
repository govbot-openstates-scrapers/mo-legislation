{"legislative_session": "2026", "identifier": "SB 990", "title": "Requires motorcycle operators and passengers to wear protective headgear", "from_organization": "~{\"classification\": \"upper\"}", "classification": ["bill"], "subject": [], "abstracts": [{"note": "abstract", "abstract": "SB 990 - Current law allows any qualified motorcycle operator who is aged 26 or older to operate a motorcycle or motortricycle without wearing protective headgear. This act repeals such provision and requires every person operating or riding as a passenger on a motorcycle or motortricycle to wear protective headgear.\r\n\r\n\tThis act is identical to HB 3119 (2026). \r\nTAYLOR MIDDLETON"}], "other_titles": [{"note": "", "title": "Requires motorcycle operators and passengers to wear protective headgear"}], "other_identifiers": [{"identifier": "ocd-bill-mo-2026-sb990"}], "actions": [{"description": "Second Read and Referred S Transportation, Infrastructure and Public Safety Committee", "date": "2026-01-08T06:00:00+00:00", "organization_id": "~{\"classification\": \"upper\"}", "classification": ["reading-2", "referral-committee"], "related_entities": []}, {"description": "S First Read", "date": "2026-01-07T06:00:00+00:00", "organization_id": "~{\"classification\": \"upper\"}", "classification": ["reading-1"], "related_entities": []}, {"description": "Prefiled", "date": "2025-12-01T06:00:00+00:00", "organization_id": "~{\"classification\": \"upper\"}", "classification": [], "related_entities": []}], "sponsorships": [{"name": "Tracy McCreery", "classification": "primary", "entity_type": "person", "primary": true, "person_id": "~{\"chamber\": \"upper\", \"name\": \"Tracy McCreery\"}", "organization_id": null}], "related_bills": [], "versions": [{"note": "4880S.01I - Introduced", "links": [{"url": "https://www.senate.mo.gov/26info/pdf-bill/intro/SB990.pdf", "media_type": "application/pdf"}], "date": "", "classification": ""}], "documents": [], "citations": [], "sources": [{"url": "https://
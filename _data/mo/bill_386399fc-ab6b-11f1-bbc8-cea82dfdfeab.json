{"legislative_session": "2026", "identifier": "SB 1296", "title": "Modifies provisions relating to income tax refunds", "from_organization": "~{\"classification\": \"upper\"}", "classification": ["bill"], "subject": [], "abstracts": [{"note": "abstract", "abstract": "SB 1296 - Current law authorizes state agencies to set off all or a portion of a taxpayer's income tax refund to repay debts owed to such state agency. This act modifies the definition of \"state agency\" to include any municipality with a population over 250,000 for debts arising on or after January 1, 2027.\r\n\r\n\tThis act is identical to SB 468 (2025) and HB 1884 (2024).\r\nJOSH NORBERG"}], "other_titles": [{"note": "", "title": "Modifies provisions relating to income tax refunds"}], "other_identifiers": [{"identifier": "ocd-bill-mo-2026-sb1296"}], "actions": [{"description": "Second Read and Referred S Economic and Workforce Development Committee", "date": "2026-01-27T06:00:00+00:00", "organization_id": "~{\"classification\": \"upper\"}", "classification": ["reading-2", "referral-committee"], "related_entities": []}, {"description": "S First Read", "date": "2026-01-07T06:00:00+00:00", "organization_id": "~{\"classification\": \"upper\"}", "classification": ["reading-1"], "related_entities": []}, {"description": "Prefiled", "date": "2025-12-01T06:00:00+00:00", "organization_id": "~{\"classification\": \"upper\"}", "classification": [], "related_entities": []}], "sponsorships": [{"name": "Patty Lewis", "classification": "primary", "entity_type": "person", "primary": true, "person_id": "~{\"chamber\": \"upper\", \"name\": \"Patty Lewis\"}", "organization_id": null}], "related_bills": [], "versions": [{"note": "4581S.01I - Introduced", "links": [{"url": "https://www.senate.mo.gov/26info/pdf-bill/intro/SB1296.pdf", "media_type": "application/pdf"}], "date": "", "classification": ""}], "documents": [], "citations": [], "sources": [{"url": "https://www.senate.mo.gov/BillTracking/Bills/BillInformation?yea
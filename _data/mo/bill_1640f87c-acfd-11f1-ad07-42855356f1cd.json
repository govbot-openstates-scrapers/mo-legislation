{"legislative_session": "2026", "identifier": "SB 1242", "title": "Establishes the Missouri Crime Victims Fund", "from_organization": "~{\"classification\": \"upper\"}", "classification": ["bill"], "subject": [], "abstracts": [{"note": "abstract", "abstract": "SB 1242 - This act establishes the \"Missouri Crime Victims Fund\", which shall consist of moneys appropriated by the General Assembly. Moneys in the fund shall be disbursed to entitlement jurisdictions, eligible entities, or local governmental entities that are eligible for victim assistance grants under the federal Victims of Crime Act.\r\n\r\n\tThis act is identical to a provision in SCS/SB 893 (2026), and is substantially similar to HCS/HB 2418 (2026)\r\nTRISTAN BENSON, JR."}], "other_titles": [{"note": "", "title": "Establishes the Missouri Crime Victims Fund"}], "other_identifiers": [{"identifier": "ocd-bill-mo-2026-sb1242"}], "actions": [{"description": "Second Read and Referred S Families, Seniors and Health Committee", "date": "2026-01-27T06:00:00+00:00", "organization_id": "~{\"classification\": \"upper\"}", "classification": ["reading-2", "referral-committee"], "related_entities": []}, {"description": "S First Read", "date": "2026-01-07T06:00:00+00:00", "organization_id": "~{\"classification\": \"upper\"}", "classification": ["reading-1"], "related_entities": []}, {"description": "Prefiled", "date": "2025-12-01T06:00:00+00:00", "organization_id": "~{\"classification\": \"upper\"}", "classification": [], "related_entities": []}], "sponsorships": [{"name": "Jill Carter", "classification": "primary", "entity_type": "person", "primary": true, "person_id": "~{\"chamber\": \"upper\", \"name\": \"Jill Carter\"}", "organization_id": null}], "related_bills": [], "versions": [{"note": "5181S.01I - Introduced", "links": [{"url": "https://www.senate.mo.gov/26info/pdf-bill/intro/SB1242.pdf", "media_type": "application/pdf"}], "date": "", "classification": ""}], "documents": [], "citations": [], "sources": [{"url
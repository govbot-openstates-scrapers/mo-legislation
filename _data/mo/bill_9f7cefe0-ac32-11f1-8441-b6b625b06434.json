{"legislative_session": "2026", "identifier": "SB 1143", "title": "Modifies provisions relating to certificates of need for long-term care facilities", "from_organization": "~{\"classification\": \"upper\"}", "classification": ["bill"], "subject": [], "abstracts": [{"note": "abstract", "abstract": "SB 1143 - Under current law, a certificate of need is not required for transfer of ownership of an existing and operational health facility in its entirety.  This act requires a certificate of need for any such transfer of an assisted living, intermediate care, residential, or skilled nursing facility.\r\n\r\n\tThis act is identical to a provision of SB 733 (2025).\r\nSARAH HASKINS"}], "other_titles": [{"note": "", "title": "Modifies provisions relating to certificates of need for long-term care facilities"}], "other_identifiers": [{"identifier": "ocd-bill-mo-2026-sb1143"}], "actions": [{"description": "Second Read and Referred S Families, Seniors and Health Committee", "date": "2026-01-15T06:00:00+00:00", "organization_id": "~{\"classification\": \"upper\"}", "classification": ["reading-2", "referral-committee"], "related_entities": []}, {"description": "S First Read", "date": "2026-01-07T06:00:00+00:00", "organization_id": "~{\"classification\": \"upper\"}", "classification": ["reading-1"], "related_entities": []}, {"description": "Prefiled", "date": "2025-12-01T06:00:00+00:00", "organization_id": "~{\"classification\": \"upper\"}", "classification": [], "related_entities": []}], "sponsorships": [{"name": "Adam Schnelting", "classification": "primary", "entity_type": "person", "primary": true, "person_id": "~{\"chamber\": \"upper\", \"name\": \"Adam Schnelting\"}", "organization_id": null}], "related_bills": [], "versions": [{"note": "5192S.01I - Introduced", "links": [{"url": "https://www.senate.mo.gov/26info/pdf-bill/intro/SB1143.pdf", "media_type": "application/pdf"}], "date": "", "classification": ""}], "documents": [], "citations": [], "sources": [{"url": "https://
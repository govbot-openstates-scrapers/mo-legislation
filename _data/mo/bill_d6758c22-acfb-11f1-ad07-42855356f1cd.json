{"legislative_session": "2026", "identifier": "SB 1108", "title": "Regulates human and pet cemeteries", "from_organization": "~{\"classification\": \"upper\"}", "classification": ["bill"], "subject": [], "abstracts": [{"note": "abstract", "abstract": "SB 1108 - This act defines human and pet cemeteries as cemeteries for purposes of licensing and endowed care under state law.  A \"human and pet cemetery\" is defined in the act as a tract of real estate separate from a cemetery in which both human remains and animal remains may be interred and memorialized at the discretion of the lot holder.\r\n\r\n\tThis act is identical to SB 551 (2025) and HB 2672 (2024), substantially similar to SB 486 (2023) and HB 2696 (2022), and similar to HB 929 (2023).\r\nSARAH HASKINS"}], "other_titles": [{"note": "", "title": "Regulates human and pet cemeteries"}], "other_identifiers": [{"identifier": "ocd-bill-mo-2026-sb1108"}], "actions": [{"description": "Second Read and Referred S Agriculture, Food Production and Outdoor Resources Committee", "date": "2026-01-15T06:00:00+00:00", "organization_id": "~{\"classification\": \"upper\"}", "classification": ["reading-2", "referral-committee"], "related_entities": []}, {"description": "S First Read", "date": "2026-01-07T06:00:00+00:00", "organization_id": "~{\"classification\": \"upper\"}", "classification": ["reading-1"], "related_entities": []}, {"description": "Prefiled", "date": "2025-12-01T06:00:00+00:00", "organization_id": "~{\"classification\": \"upper\"}", "classification": [], "related_entities": []}], "sponsorships": [{"name": "Steven Roberts", "classification": "primary", "entity_type": "person", "primary": true, "person_id": "~{\"chamber\": \"upper\", \"name\": \"Steven Roberts\"}", "organization_id": null}], "related_bills": [], "versions": [{"note": "4776S.01I - Introduced", "links": [{"url": "https://www.senate.mo.gov/26info/pdf-bill/intro/SB1108.pdf", "media_type": "application/pdf"}], "date": "", "classification": ""}], "doc